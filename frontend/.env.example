# Base URL of the NestJS backend, including the /api global prefix.
# Must keep the NEXT_PUBLIC_ prefix so it is exposed to the browser.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# For a deployed backend, point this at the Render URL instead, e.g.
# NEXT_PUBLIC_API_URL="https://swiftstruct-api.onrender.com/api"
